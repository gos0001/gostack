package {{.PackageName}}

import (
	"github.com/gin-gonic/gin"

	httpserver "{{.ModulePath}}/pkg/http_server"
)

type HTTPv1Handler struct {
	uc *Usecase
}

func NewHTTPv1(uc *Usecase) *HTTPv1Handler {
	return &HTTPv1Handler{uc: uc}
}

func (h *HTTPv1Handler) Handle(c *gin.Context) {
	var input Input
	if err := c.ShouldBindJSON(&input); err != nil {
		httpserver.BadRequest(c, err.Error())
		return
	}
	if err := input.Validate(); err != nil {
		httpserver.BadRequest(c, err.Error())
		return
	}

	out, err := h.uc.Execute(c.Request.Context(), input)
	if err != nil {
		// TODO: map this use case's domain errors to statuses before the
		// fallthrough, with a switch on errors.Is. Everything unmapped is a
		// 500 and must be logged rather than echoed — see
		// @sections/domain-errors.md.
		httpserver.InternalServerError(c, "internal server error")
		return
	}

	httpserver.OK(c, out)
}

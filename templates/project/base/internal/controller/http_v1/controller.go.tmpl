// New builds the router and registers every JSON API route.
// Routing only — no business logic, no adapters, no domain types.
func New(
	// gostack:params
) *gin.Engine {
	r := gin.New()
	r.Use(gin.Recovery())

	v1 := r.Group("/api/v1")
	_ = v1

	// gostack:routes

	return r
}

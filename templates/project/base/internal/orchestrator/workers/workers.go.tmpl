// The Start and Stop policies below are yours to tune. The marker comments are
// not: the CLI splices at them, and deleting one silently stops the next
// generator from registering anything here.
package workers

import (
	"context"
	"errors"
	"sync"
	"time"

	"go.uber.org/zap"
	// gostack:imports
)

// Worker is one long-running background process. A use case that runs in the
// background implements this from its own workers.go — one handler file per
// caller, named after the caller.
type Worker interface {
	Name() string
	WorkersRun(ctx context.Context) error
}

// Workers owns the lifecycle of every background goroutine. Sequencing only:
// the work lives in the use cases.
type Workers struct {
	logger  *zap.SugaredLogger
	cfg     Config
	workers []Worker

	cancel context.CancelFunc
	wg     sync.WaitGroup
}

func New(
	logger *zap.SugaredLogger,
	cfg Config,
	// gostack:params
) *Workers {
	w := &Workers{logger: logger, cfg: cfg}
	// gostack:routes

	return w
}

// Start launches each worker in its own goroutine and returns immediately. A
// worker that dies is logged, never fatal — a broken background job must not
// take the HTTP server down with it.
func (w *Workers) Start(ctx context.Context) {
	ctx, w.cancel = context.WithCancel(ctx)

	for _, worker := range w.workers {
		w.wg.Add(1)
		go func() {
			defer w.wg.Done()
			w.logger.Infow("worker started", "worker", worker.Name())
			if err := worker.WorkersRun(ctx); err != nil && !errors.Is(err, context.Canceled) {
				w.logger.Errorw("worker failed", "worker", worker.Name(), "error", err)
			}
		}()
	}
}

// Stop cancels every worker and waits for them, bounded by the configured
// grace period. Call it after the HTTP server has stopped accepting requests
// but before the pools close — workers hold connections from them.
func (w *Workers) Stop() {
	if w.cancel == nil {
		return
	}
	w.cancel()

	done := make(chan struct{})
	go func() {
		w.wg.Wait()
		close(done)
	}()

	select {
	case <-done:
		w.logger.Info("workers stopped")
	case <-time.After(w.cfg.ShutdownTimeout):
		w.logger.Warn("workers did not stop within the grace period")
	}
}

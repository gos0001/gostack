APP_ADDR=:8080
APP_ENV=development

BOOTSTRAP_TIMEOUT=60s
CRON_SHUTDOWN_TIMEOUT=15s
{{if .WithFrontend}}
VIEWS_DEV_MODE=true
VIEWS_TEMPLATES_DIR=views
VIEWS_STATIC_DIR=static
{{end}}
{{- if .WithPostgres}}
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/{{.ProjectName}}_dev?sslmode=disable
{{end}}
{{- if .WithRedis}}
REDIS_URL=redis://localhost:6379
{{end}}

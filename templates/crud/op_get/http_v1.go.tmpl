package {{.PackageName}}

import (
	"errors"

	"github.com/gin-gonic/gin"

	"{{.ModulePath}}/internal/domain"
	httpserver "{{.ModulePath}}/pkg/http_server"
)

type HTTPv1Handler struct {
	uc *Usecase
}

func NewHTTPv1(uc *Usecase) *HTTPv1Handler {
	return &HTTPv1Handler{uc: uc}
}

func (h *HTTPv1Handler) Handle(c *gin.Context) {
	input := Input{ID: c.Param("id")}
	if err := input.Validate(); err != nil {
		httpserver.BadRequest(c, err.Error())
		return
	}

	out, err := h.uc.Execute(c.Request.Context(), input)
	if err != nil {
		switch {
		case errors.Is(err, domain.Err{{.PascalEntity}}NotFound):
			httpserver.NotFound(c, "{{.EntityName}} not found")
		default:
			httpserver.InternalServerError(c, "internal server error")
		}
		return
	}

	httpserver.OK(c, out)
}
